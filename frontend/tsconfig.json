{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "paths": {
      "app/*": ["./src/app/*"],
      "features/*": ["./src/features/*"],
      "shared/*": ["./src/shared/*"],
      "styles/*": ["./src/styles/*"]
    }
  },
  "include": ["src"]
}
